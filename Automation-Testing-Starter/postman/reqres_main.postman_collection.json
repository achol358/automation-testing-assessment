    {
      "name": "Q6 - Patch User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"PATCH status is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst data = pm.response.json();\r\n\r\npm.test(\"Job updated correctly\", function () {\r\n    pm.expect(data.job).to.eql(\"Lead QA Engineer\");\r\n});\r\n\r\npm.test(\"Updated timestamp exists\", function () {\r\n    pm.expect(data.updatedAt).to.be.a(\"string\");\r\n    pm.expect(\r\n        Number.isNaN(Date.parse(data.updatedAt))\r\n    ).to.eql(false);\r\n});\r\n"
            ]
          }
        }
      ],
